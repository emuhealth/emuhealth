{
  "name": "@emuhealth/healthlake",
  "version": "1.0.0",
  "private": true,
  "description": "AWS HealthLake emulator for emuhealth: the HealthLake control plane (datastores, import and export jobs) and per-datastore FHIR R4 data planes, with SigV4 request verification.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "homepage": "https://www.emuhealth.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/emuhealth/emuhealth.git",
    "directory": "packages/@emuhealth/healthlake"
  },
  "bugs": {
    "url": "https://github.com/emuhealth/emuhealth/issues"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsup --clean",
    "dev": "tsup --watch",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "prepack": "node ../../../scripts/prepare-package.mjs"
  },
  "devDependencies": {
    "@emuhealth/fhir-core": "workspace:*",
    "@emulators/core": "workspace:*",
    "@smithy/hash-node": "^4.5.2",
    "@smithy/signature-v4": "^5.7.4",
    "tsup": "^8",
    "typescript": "^5.7",
    "vitest": "^4.1.0"
  }
}
