{
  "name": "emuhealth",
  "version": "0.1.1",
  "description": "Local drop-in replacement services for healthcare and life science APIs, plus the emulate service suite, for CI and no-network sandboxes",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/api.js",
      "types": "./dist/api.d.ts"
    },
    "./cli": {
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/api.js",
  "types": "./dist/api.d.ts",
  "homepage": "https://github.com/emuhealth/emuhealth#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/emuhealth/emuhealth.git",
    "directory": "packages/emuhealth"
  },
  "bugs": {
    "url": "https://github.com/emuhealth/emuhealth/issues"
  },
  "keywords": [
    "emulator",
    "mock",
    "api",
    "healthcare",
    "fhir",
    "smart-on-fhir",
    "life-science",
    "testing",
    "ci",
    "local-development"
  ],
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "bin": {
    "emuhealth": "./dist/index.js"
  },
  "scripts": {
    "prepack": "node ../../scripts/prepare-package.mjs",
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo",
    "type-check": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "commander": "^14",
    "picocolors": "^1.1.1",
    "yaml": "^2"
  },
  "devDependencies": {
    "@emulators/core": "workspace:*",
    "@emulators/github": "workspace:*",
    "@emulators/apple": "workspace:*",
    "@emulators/microsoft": "workspace:*",
    "@emulators/okta": "workspace:*",
    "@emulators/aws": "workspace:*",
    "@emulators/google": "workspace:*",
    "@emulators/mongoatlas": "workspace:*",
    "@emulators/slack": "workspace:*",
    "@emulators/vercel": "workspace:*",
    "@emulators/resend": "workspace:*",
    "@emulators/stripe": "workspace:*",
    "@emulators/clerk": "workspace:*",
    "@emulators/linear": "workspace:*",
    "@emulators/twilio": "workspace:*",
    "tsup": "^8",
    "typescript": "^5.7"
  }
}
